<%- include('../partials/header') %>

  <!-- ==================== HERO ==================== -->
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-text">
        <div class="hero-badge">
          <span class="dot"></span>
          #1 Restaurant in the City
        </div>

        <h1 class="hero-title">
          Desire <span class="highlight">Food</span><br>
          for Your Taste
        </h1>

        <p class="hero-desc">
          Food is what we eat to stay alive and healthy. It comes in many different
          forms and flavors, from fruits and vegetables to meats and grains. Order now
          and experience the taste of perfection.
        </p>

        <div class="hero-buttons">
          <a href="/menu" class="btn btn-primary btn-lg">Order Now</a>
          <a href="#about" class="btn btn-outline-primary btn-lg">Learn More</a>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <div class="hero-image-blob">
          <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=600&q=85"
            alt="Delicious Pizza">
        </div>

        <!-- Floating Badges -->
        <div class="floating-badge rating">
          <div class="badge-icon green">⭐</div>
          <div class="badge-text">
            <strong>4.8 Rating</strong>
            <span>2k+ Reviews</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURES ==================== -->
  <section class="features-strip">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card fade-in-up">
          <div class="feature-icon orange">🍽️</div>
          <h3>Quality Food</h3>
          <p>Fresh ingredients sourced daily from local farms and premium suppliers.</p>
        </div>
        <div class="feature-card fade-in-up">
          <div class="feature-icon red">🛍️</div>
          <h3>Quick Pickup</h3>
          <p>Order ahead and pick up your freshly prepared meal from our counter — hot and ready.</p>
        </div>
        <div class="feature-card fade-in-up">
          <div class="feature-icon green">💳</div>
          <h3>Easy Payment</h3>
          <p>Multiple payment options including cash, cards, and digital wallets.</p>
        </div>
        <div class="feature-card fade-in-up">
          <div class="feature-icon blue">🛒</div>
          <h3>Quick Checkout</h3>
          <p>Seamless ordering experience with just a few clicks.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="about-section" id="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-image">
          <img src="https://images.unsplash.com/photo-1600891964599-f61ba0e24092?auto=format&fit=crop&w=600&q=85"
            alt="Our Chef preparing food">
          <div class="experience-badge">
            <span class="number">15+</span>
            <span class="label">Years of Experience</span>
          </div>
        </div>

        <div class="about-content">
          <span class="section-label">About Us</span>
          <h2 class="section-title">We Provide Healthy Food For Your Family</h2>
          <div class="about-text">
            <p>
              Our story began 15 years ago with a simple vision: to create a place where
              families could enjoy wholesome, delicious meals made with the freshest ingredients.
              Our head chef, with over two decades of culinary mastery, crafts each dish as a
              work of art.
            </p>
            <p>
              We believe food isn't just nourishment — it's an experience. From our wood-fired
              ovens to our hand-picked herbs, every detail matters. That's what makes Servely special.
            </p>
          </div>

          <div class="about-stats">
            <div class="stat-item">
              <div class="stat-num">50+</div>
              <div class="stat-label">Menu Items</div>
            </div>
            <div class="stat-item">
              <div class="stat-num">15K+</div>
              <div class="stat-label">Happy Customers</div>
            </div>
            <div class="stat-item">
              <div class="stat-num">4.8</div>
              <div class="stat-label">Average Rating</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ORDER OPTIONS ==================== -->
  <section class="order-section" id="order-options">
    <div class="container">
      <div class="text-center">
        <span class="section-label">Order Now</span>
        <h2 class="section-title">How Would You Like to Dine?</h2>
        <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto;">
          Choose your preferred dining experience and explore our curated menu.
        </p>
      </div>

      <div class="order-options-grid">
        <div class="order-card" onclick="window.location.href='/book-table'">
          <span class="card-emoji">🍽️</span>
          <h3>Dine-In</h3>
          <p>Enjoy a memorable evening surrounded by our cozy ambiance and live music. Reserve your table now.</p>
          <span class="btn btn-primary">Book a Table</span>
        </div>

        <div class="order-card" onclick="window.location.href='/menu'">
          <span class="card-emoji">🛍️</span>
          <h3>Take Away</h3>
          <p>Order ahead and pick up your freshly prepared meal from our counter — hot and ready when you arrive.</p>
          <span class="btn btn-outline-primary">Order for Pickup</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MEMBERSHIP ==================== -->
  <section class="membership-section" id="membership">
    <div class="container">
      <div class="text-center">
        <span class="section-label" style="color: var(--primary-light);">Membership</span>
        <h2 class="section-title">Join Our Exclusive Club</h2>
        <p style="color: rgba(255,255,255,0.6); max-width: 500px; margin: 0 auto;">
          Get special discounts, priority reservations, and exclusive access to members-only events.
        </p>
      </div>

      <div class="membership-grid">
        <!-- Silver Plan -->
        <div class="membership-card fade-in-up">
          <div class="plan-icon silver">🥈</div>
          <h3>Silver</h3>
          <div class="plan-price">$9.99</div>
          <div class="plan-period">per month</div>
          <ul class="plan-features">
            <li>5% discount on all orders</li>
            <li>Free delivery on orders $30+</li>
            <li>Birthday special dessert</li>
            <li>Early menu access</li>
          </ul>
          <a href="#" onclick="handleMembershipClick(event, 'Silver')" class="btn btn-outline-primary btn-full">Get Started</a>
        </div>

        <!-- Gold Plan (Popular) -->
        <div class="membership-card popular fade-in-up">
          <span class="popular-tag">POPULAR</span>
          <div class="plan-icon gold">🥇</div>
          <h3>Gold</h3>
          <div class="plan-price">$19.99</div>
          <div class="plan-period">per month</div>
          <ul class="plan-features">
            <li>15% discount on all orders</li>
            <li>Free delivery — always</li>
            <li>Priority table reservations</li>
            <li>Exclusive monthly tasting events</li>
            <li>Complimentary chef's special</li>
          </ul>
          <a href="#" onclick="handleMembershipClick(event, 'Gold')" class="btn btn-primary btn-full">Get Started</a>
        </div>

        <!-- Platinum Plan -->
        <div class="membership-card fade-in-up">
          <div class="plan-icon platinum">💎</div>
          <h3>Platinum</h3>
          <div class="plan-price">$39.99</div>
          <div class="plan-period">per month</div>
          <ul class="plan-features">
            <li>25% discount on all orders</li>
            <li>Free delivery — always</li>
            <li>Private dining room access</li>
            <li>Personal chef consultations</li>
            <li>Invite-only gourmet events</li>
            <li>Complimentary wine pairing</li>
          </ul>
          <a href="#" onclick="handleMembershipClick(event, 'Platinum')" class="btn btn-outline-primary btn-full">Get Started</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function handleMembershipClick(e, tier) {
      e.preventDefault();
      
      const prices = { 'Silver': '$9.99', 'Gold': '$19.99', 'Platinum': '$39.99' };
      const price = prices[tier];

      // Ask to pay without a separate page
      const confirmed = confirm(`You have selected the ${tier} Membership (${price}/month).\n\nClick OK to pay and activate your benefits.`);
      
      if (confirmed) {
        // Instantly activate membership and go to menu
        localStorage.setItem('membership', tier);
        alert('Payment Successful! Your benefits are now active.');
        window.location.href = '/menu';
      }
    }
  </script>

  <%- include('../partials/footer') %>