<%- include('../partials/header') %>

  <style>
    /* ── Category Tabs ── */
    .menu-category-tabs {
      display: flex;
      gap: 10px;
      margin-bottom: 35px;
      flex-wrap: wrap;
    }

    .menu-cat-tab {
      padding: 9px 22px;
      border-radius: 50px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      border: 2px solid var(--border);
      background: #fff;
      color: var(--text-light);
      transition: all var(--transition);
    }

    .menu-cat-tab:hover,
    .menu-cat-tab.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    /* ── Menu card enhanced ── */
    .menu-card {
      background: #fff;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: all var(--transition);
      border: 1px solid transparent;
    }

    .menu-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
      border-color: rgba(255, 107, 53, 0.2);
    }

    .menu-img {
      position: relative;
      height: 180px;
      overflow: hidden;
      background: var(--bg-cream);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .menu-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s;
    }

    .menu-img .no-img {
      font-size: 3rem;
    }

    .menu-card:hover .menu-img img {
      transform: scale(1.08);
    }

    .menu-tag {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--accent);
      color: #fff;
      padding: 4px 12px;
      border-radius: 50px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .menu-info {
      padding: 18px;
    }

    .menu-info-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 6px;
    }

    .menu-info-top h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--dark);
    }

    .price {
      font-weight: 700;
      color: var(--primary);
      font-size: 1.1rem;
      white-space: nowrap;
    }

    .item-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 14px;
      line-height: 1.5;
    }

    .menu-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .rating-stars {
      display: flex;
      gap: 2px;
      color: #F59E0B;
      font-size: 0.82rem;
    }

    .add-to-cart-btn {
      background: var(--primary);
      color: #fff;
      border: none;
      padding: 8px 16px;
      border-radius: 50px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition);
      font-family: var(--font-sans);
    }

    .add-to-cart-btn:hover {
      background: var(--primary-dark);
      transform: scale(1.05);
      box-shadow: var(--shadow-orange);
    }

    /* ── Cart item row ── */
    .cart-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
    }

    .cart-item-info h4 {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--dark);
      margin-bottom: 3px;
    }

    .cart-item-price {
      color: var(--primary);
      font-weight: 600;
      font-size: 0.88rem;
    }

    .cart-item-actions {
      display: flex;
      align-items: center;
      gap: 7px;
      background: var(--bg-warm);
      border-radius: 50px;
      padding: 3px 7px;
    }

    .cart-btn {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      border: none;
      background: #fff;
      color: var(--dark);
      cursor: pointer;
      font-size: 1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition);
      box-shadow: var(--shadow-sm);
    }

    .cart-btn:hover {
      background: var(--primary);
      color: #fff;
    }

    .cart-qty {
      font-weight: 700;
      min-width: 18px;
      text-align: center;
      font-size: 0.88rem;
    }

    /* ── Loading state ── */
    .menu-loading {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }

    .menu-loading .spinner {
      width: 44px;
      height: 44px;
      border: 4px solid var(--border);
      border-top-color: var(--primary);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 16px;
    }
/* 🔥 BILL MODAL */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.6);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.bill-modal {
  background: #fff;
  border-radius: 16px;
  width: 90%;
  max-width: 420px;
  padding: 25px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  animation: scaleUp 0.3s ease;
}

@keyframes scaleUp {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.bill-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.bill-header h2 {
  font-size: 1.4rem;
  font-weight: 700;
}

.bill-header button {
  background: none;
  border: none;
  font-size: 1.4rem;
  cursor: pointer;
}

.bill-body {
  margin-bottom: 20px;
}

.bill-body p {
  display: flex;
  justify-content: space-between;
  margin: 6px 0;
  font-size: 0.95rem;
}

#billTotal {
  font-weight: 700;
  color: var(--primary);
}

#payBtn {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 50px;
  background: var(--primary);
  color: #fff;
  font-weight: 600;
  cursor: pointer;
  transition: 0.2s;
}

#payBtn:hover {
  background: var(--primary-dark);
}
    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>

  <div class="menu-page">
    <div class="container">
      <!-- Menu Header -->
      <div class="menu-header">
        <span class="section-label">Our Menu</span>
        <h1 class="section-title">Explore Our Delicious Menu</h1>
        <p>Discover a curated selection of flavors crafted with love and the finest ingredients.</p>
      </div>

      <div class="menu-layout">
        <!-- Menu Items Section -->
        <div class="menu-main" id="menuMain">
          <div class="menu-loading">
            <div class="spinner"></div>
            <p>Loading menu...</p>
          </div>
        </div>

        <!-- Cart Sidebar -->
        <aside class="cart-sidebar">
          <div class="cart-box">
            <h2>🛒 Your Cart</h2>
            <div class="cart-divider"></div>

            <div id="cart-items" class="cart-items-list">
              <p class="empty-cart-msg text-center">Your cart is empty.</p>
            </div>

            <div class="cart-summary" style="display: none;" id="cartSummary">
              <div class="cart-row">
                <span>Subtotal</span>
                <span id="cartSubtotal">$0.00</span>
              </div>
              <div class="cart-row" id="cartDiscountRow" style="display: none; color: var(--primary);">
                <span id="cartDiscountName">Discount</span>
                <span id="cartDiscount">-$0.00</span>
              </div>
              <div class="cart-row">
                <span>Tax (8%)</span>
                <span id="cartTax">$0.00</span>
              </div>
              <div class="cart-row total-row">
                <span>Total</span>
                <span id="cartTotal">$0.00</span>
              </div>

              <% if (locals.user) { %>
                <button class="btn btn-primary btn-full mt-2" id="checkoutBtn">🎉 Place Order</button>
                <% } else { %>
                  <a href="/auth/login" class="btn btn-primary btn-full mt-2 text-center"
                    style="display:block; text-align:center;">Login to Checkout</a>
                  <% } %>
            </div>
          </div>
        </aside>
      </div>
    </div>
    <!-- Bill Modal -->
<div class="modal-overlay" id="billModal">
  <div class="bill-modal">

    <div id="billContent">
      <div class="bill-header">
        <h2>Your Bill</h2>
        <button id="closeBillBtn">✕</button>
      </div>

      <div class="bill-body">
        <div id="billItemsContainer"></div>

        <div>
          <p>Subtotal: <span id="billSubtotal"></span></p>
          <p id="billDiscountRow" style="display:none;">
            Discount: <span id="billDiscount"></span>
          </p>
          <p>Tax: <span id="billTax"></span></p>
          <h3>Total: <span id="billTotal"></span></h3>
        </div>
      </div>

      <button id="payBtn">Pay</button>
    </div>

    <div id="successContent" style="display:none;">
      <h2>Payment Successful 🎉</h2>
    </div>

  </div>
</div>
  </div>

  <script>
    //bill script
    function calculateBill(subtotal) {
  let discountRate = 0;
  let discountName = '';

  const membership = localStorage.getItem('membership');

  if (membership === 'Silver') {
    discountRate = 0.05;
    discountName = 'Silver (5%)';
  } else if (membership === 'Gold') {
    discountRate = 0.15;
    discountName = 'Gold (15%)';
  } else if (membership === 'Platinum') {
    discountRate = 0.25;
    discountName = 'Platinum (25%)';
  }

  const discount = subtotal * discountRate;
  const afterDiscount = subtotal - discount;
  const tax = afterDiscount * 0.08;
  const total = afterDiscount + tax;

  return {
    subtotal,
    discount,
    discountRate,
    discountName,
    tax,
    total
  };
}
    // ─── Cart State ───────────────────────────────────────────────
    const cart = {}; // { itemId: { name, price, qty } }

    function updateCartUI() {
      const cartItemsEl = document.getElementById('cart-items');
      const cartSummaryEl = document.getElementById('cartSummary');
      const ids = Object.keys(cart).filter(k => cart[k].qty > 0);

      if (ids.length === 0) {
        cartItemsEl.innerHTML = '<p class="empty-cart-msg text-center">Your cart is empty.</p>';
        cartSummaryEl.style.display = 'none';
        return;
      }

      cartItemsEl.innerHTML = ids.map(id => `
      <div class="cart-item">
        <div class="cart-item-info">
          <h4>${cart[id].name}</h4>
          <span class="cart-item-price">₹${(cart[id].price * cart[id].qty).toFixed(2)}</span>
        </div>
        <div class="cart-item-actions">
          <button class="cart-btn" onclick="changeQty('${id}', -1)">−</button>
          <span class="cart-qty">${cart[id].qty}</span>
          <button class="cart-btn" onclick="changeQty('${id}', 1)">+</button>
        </div>
      </div>
    `).join('');

      const subtotal = ids.reduce((s, id) => s + cart[id].price * cart[id].qty, 0);

      const bill = calculateBill(subtotal);

      document.getElementById('cartSubtotal').textContent = '₹' + bill.subtotal.toFixed(2);

      const discountRow = document.getElementById('cartDiscountRow');
      if (bill.discountRate > 0) {
        discountRow.style.display = 'flex';
       document.getElementById('cartDiscountName').textContent = 'Discount ' + bill.discountName;
document.getElementById('cartDiscount').textContent = '-₹' + bill.discount.toFixed(2);
      } else {
        if (discountRow) discountRow.style.display = 'none';
      }

      document.getElementById('cartTax').textContent = '₹' + bill.tax.toFixed(2);
document.getElementById('cartTotal').textContent = '₹' + bill.total.toFixed(2);
      cartSummaryEl.style.display = 'block';
    }

  async function addToCart(id, name, price) {
  const token = localStorage.getItem("token");
  const cartId = localStorage.getItem("cartId");

  // Not logged in
  if (!token) {
    alert("Please login first");
    return;
  }

  // 🔥 PARCEL FLOW (no table selected)
  if (!cartId) {
    if (!cart[id]) cart[id] = { name, price: parseFloat(price), qty: 0 };
    cart[id].qty++;
    updateCartUI();
    return;
  }

  // 🔥 DINE-IN FLOW
  try {
    await fetch('/api/dine-in/cart/add', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`
      },
      body: JSON.stringify({
        cartId,
        dishId: id,
        quantity: 1
      })
    });

    if (!cart[id]) cart[id] = { name, price: parseFloat(price), qty: 0 };
    cart[id].qty++;
    updateCartUI();

  } catch (err) {
    console.error(err);
    alert("Failed to add item");
  }
}

    function changeQty(id, delta) {
      if (!cart[id]) return;
      cart[id].qty = Math.max(0, cart[id].qty + delta);
      if (cart[id].qty === 0) delete cart[id];
      updateCartUI();
    }

    // ─── Render Menu ─────────────────────────────────────────────
function renderMenu(items) {
  const container = document.getElementById('menuMain');

  if (!items || items.length === 0) {
    container.innerHTML = '<p>No items available</p>';
    return;
  }

  container.innerHTML = `
    <div class="menu-grid">
      ${items.map(item => `
        <div class="menu-card">
          
          <div class="menu-img">
            <span class="menu-tag">New</span>
            ${
              item.image
                ? `<img src="${item.image}" alt="${item.name}" loading="lazy">`
                : `<span class="no-img">🍽️</span>`
            }
          </div>

          <div class="menu-info">

            
            <div class="menu-info-top">
              <h3>${item.name}</h3>
              <span class="price">₹${Number(item.price).toFixed(2)}</span>
            </div>

            <p class="item-desc">
              ${item.description || 'Freshly prepared with quality ingredients.'}
            </p>

            <div class="menu-card-footer">
              <div class="rating-stars">⭐⭐⭐⭐⭐</div>

              <button class="add-to-cart-btn"
                onclick="addToCart('${item._id}', '${(item.name || '').replace(/'/g, "\\'")}', ${item.price})">
                Add to Cart
              </button>
            </div>

          </div>
        </div>
      `).join('')}
    </div>
  `;
}

      


    function filterCategory(cat, btn) {
      // Update active tab
      document.querySelectorAll('.menu-cat-tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      // Show/hide sections
      document.querySelectorAll('.menu-category').forEach(sec => {
        if (cat === 'all' || sec.dataset.cat === cat) {
          sec.style.display = '';
        } else {
          sec.style.display = 'none';
        }
      });
    }

    // ─── Fetch Menu ──────────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async () => {
  const container = document.getElementById('menuMain');

  try {
    const res = await fetch('/api/menu'); // ✅ FIX

    if (!res.ok) throw new Error('Server error ' + res.status);

    const result = await res.json();

    const items = Array.isArray(result.data) ? result.data : [];
    renderMenu(items);

  } catch (err) {
    console.error('Menu fetch error:', err);
    container.innerHTML = `
      <div class="menu-loading">
        <p style="color:var(--accent);">⚠️ Failed to load menu.</p>
      </div>`;
  }
});
document.addEventListener("DOMContentLoaded", () => {
  const checkoutBtn = document.getElementById("checkoutBtn");
  const billModal = document.getElementById("billModal");
  const payBtn = document.getElementById("payBtn");

  if (payBtn) {
  payBtn.addEventListener("click", async () => {
    const token = localStorage.getItem("token");
    const cartId = localStorage.getItem("cartId");

    try {
      let res;

      if (cartId) {
        // 🔥 DINE-IN CHECKOUT
        res = await fetch("/api/dine-in/checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({ cartId })
        });

      } else {
        // 🔥 PARCEL CHECKOUT
        res = await fetch("/api/parcel/checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`
          },
          body: JSON.stringify({
            items: Object.values(cart)
          })
        });
      }

      const data = await res.json();

      if (!res.ok) throw new Error(data.message);

      alert("Order placed successfully!");

      Object.keys(cart).forEach(k => delete cart[k]);
      updateCartUI();

      billModal.style.display = "none";

    } catch (err) {
      alert(err.message);
    }
  });
}

  // 🔥 OPEN BILL MODAL
if (checkoutBtn) {
  checkoutBtn.addEventListener("click", () => {
    const ids = Object.keys(cart);

    if (ids.length === 0) {
      alert("Cart is empty!");
      return;
    }

    let subtotal = 0;

    const html = ids.map(id => {
      const total = cart[id].price * cart[id].qty;
      subtotal += total;

      return `<div style="display:flex;justify-content:space-between;margin-bottom:8px;">
        <span>${cart[id].name} x${cart[id].qty}</span>
        <span>₹${total}</span>
      </div>`;
    }).join("");

    document.getElementById("billItemsContainer").innerHTML = html;

   const bill = calculateBill(subtotal);

document.getElementById("billSubtotal").textContent = "₹" + bill.subtotal;

const discountRow = document.getElementById("billDiscountRow");

if (bill.discountRate > 0) {
  discountRow.style.display = "block";
  document.getElementById("billDiscount").textContent =
    "-₹" + bill.discount.toFixed(2);
} else {
  discountRow.style.display = "none";
}

document.getElementById("billTax").textContent =
  "₹" + bill.tax.toFixed(2);

document.getElementById("billTotal").textContent =
  "₹" + bill.total.toFixed(2);

    billModal.style.display = "flex";
  });
}
const closeBillBtn = document.getElementById("closeBillBtn");

if (closeBillBtn) {
  closeBillBtn.addEventListener("click", () => {
    billModal.style.display = "none";
  });
}
});
  </script>

  <%- include('../partials/footer') %>