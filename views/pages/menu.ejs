<%- include('../partials/header') %>

<style>
  /* ── Category Tabs ── */
  .menu-category-tabs { display: flex; gap: 10px; margin-bottom: 35px; flex-wrap: wrap; }
  .menu-cat-tab { padding: 9px 22px; border-radius: 50px; font-size: 0.88rem; font-weight: 600; cursor: pointer; border: 2px solid var(--border); background: #fff; color: var(--text-light); transition: all var(--transition); }
  .menu-cat-tab:hover, .menu-cat-tab.active { background: var(--primary); color: #fff; border-color: var(--primary); }

  /* ── Menu card enhanced ── */
  .menu-card { background: #fff; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: all var(--transition); border: 1px solid transparent; }
  .menu-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); border-color: rgba(255,107,53,0.2); }
  .menu-img { position: relative; height: 180px; overflow: hidden; background: var(--bg-cream); display: flex; align-items: center; justify-content: center; }
  .menu-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .menu-img .no-img { font-size: 3rem; }
  .menu-card:hover .menu-img img { transform: scale(1.08); }
  .menu-tag { position: absolute; top: 12px; left: 12px; background: var(--accent); color: #fff; padding: 4px 12px; border-radius: 50px; font-size: 0.75rem; font-weight: 600; }
  .menu-info { padding: 18px; }
  .menu-info-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .menu-info-top h3 { font-size: 1rem; font-weight: 700; color: var(--dark); }
  .price { font-weight: 700; color: var(--primary); font-size: 1.1rem; white-space: nowrap; }
  .item-desc { font-size: 0.82rem; color: var(--text-muted); margin-bottom: 14px; line-height: 1.5; }
  .menu-card-footer { display: flex; justify-content: space-between; align-items: center; }
  .rating-stars { display: flex; gap: 2px; color: #F59E0B; font-size: 0.82rem; }
  .add-to-cart-btn { background: var(--primary); color: #fff; border: none; padding: 8px 16px; border-radius: 50px; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all var(--transition); font-family: var(--font-sans); }
  .add-to-cart-btn:hover { background: var(--primary-dark); transform: scale(1.05); box-shadow: var(--shadow-orange); }

  /* ── Cart item row ── */
  .cart-item { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }
  .cart-item-info h4 { font-size: 0.9rem; font-weight: 600; color: var(--dark); margin-bottom: 3px; }
  .cart-item-price { color: var(--primary); font-weight: 600; font-size: 0.88rem; }
  .cart-item-actions { display: flex; align-items: center; gap: 7px; background: var(--bg-warm); border-radius: 50px; padding: 3px 7px; }
  .cart-btn { width: 26px; height: 26px; border-radius: 50%; border: none; background: #fff; color: var(--dark); cursor: pointer; font-size: 1rem; font-weight: 700; display: flex; align-items: center; justify-content: center; transition: all var(--transition); box-shadow: var(--shadow-sm); }
  .cart-btn:hover { background: var(--primary); color: #fff; }
  .cart-qty { font-weight: 700; min-width: 18px; text-align: center; font-size: 0.88rem; }

  /* ── Loading state ── */
  .menu-loading { text-align: center; padding: 60px 20px; color: var(--text-muted); }
  .menu-loading .spinner { width: 44px; height: 44px; border: 4px solid var(--border); border-top-color: var(--primary); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
  /* ── Bill Modal ── */
  .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(5px); z-index: 1000; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease; }
  .modal-overlay.show { display: flex; opacity: 1; }
  .bill-modal { background: #fff; width: 90%; max-width: 450px; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden; transform: scale(0.9); transition: transform 0.3s ease; }
  .modal-overlay.show .bill-modal { transform: scale(1); }
  .bill-header { background: var(--primary); color: #fff; padding: 20px; text-align: center; position: relative; }
  .bill-header h2 { margin: 0; font-size: 1.5rem; font-weight: 700; }
  .close-modal { position: absolute; top: 20px; right: 20px; background: rgba(255,255,255,0.2); border: none; color: #fff; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
  .close-modal:hover { background: rgba(255,255,255,0.4); }
  .bill-body { padding: 25px; max-height: 60vh; overflow-y: auto; }
  .bill-items-list { margin-bottom: 20px; }
  .bill-item { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 0.95rem; color: var(--dark); }
  .bill-item-name { flex: 1; font-weight: 500; }
  .bill-item-qty { color: var(--text-muted); width: 40px; text-align: center; }
  .bill-item-price { font-weight: 600; width: 80px; text-align: right; }
  .bill-divider { height: 1px; background: var(--border); margin: 15px 0; border-style: dashed; }
  .bill-summary-row { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 0.95rem; color: var(--text-light); }
  .bill-total-row { display: flex; justify-content: space-between; margin-top: 15px; padding-top: 15px; border-top: 2px dashed var(--border); font-size: 1.25rem; font-weight: 800; color: var(--dark); }
  .bill-footer { padding: 20px 25px; background: var(--bg-cream); border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 15px; }
  .pay-btn { flex: 1; background: var(--primary); color: #fff; border: none; padding: 14px; border-radius: 12px; font-size: 1.1rem; font-weight: 700; cursor: pointer; transition: all var(--transition); box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3); }
  .pay-btn:hover { background: var(--primary-dark); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 107, 53, 0.4); }

  /* Success State */
  .success-content { text-align: center; padding: 40px 20px; display: none; }
  .success-icon { font-size: 4rem; color: #10B981; margin-bottom: 20px; animation: bounceIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
  .success-title { font-size: 1.5rem; font-weight: 700; color: var(--dark); margin-bottom: 10px; }
  .success-desc { color: var(--text-muted); margin-bottom: 25px; }
  @keyframes bounceIn { 0% { transform: scale(0); } 50% { transform: scale(1.2); } 100% { transform: scale(1); } }
</style>

  <div class="menu-page">
    <div class="container">
      <!-- Menu Header -->
      <div class="menu-header">
        <span class="section-label">Our Menu</span>
        <h1 class="section-title">Explore Our Delicious Menu</h1>
        <p>Discover a curated selection of flavors crafted with love and the finest ingredients.</p>
      </div>

      <div class="menu-layout">
        <!-- Menu Items Section -->
        <div class="menu-main" id="menuMain">
          <div class="menu-loading">
            <div class="spinner"></div>
            <p>Loading menu...</p>
          </div>
        </div>

        <!-- Cart Sidebar -->
        <aside class="cart-sidebar">
          <div class="cart-box">
            <h2>🛒 Your Cart</h2>
            <div class="cart-divider"></div>

            <div id="cart-items" class="cart-items-list">
              <p class="empty-cart-msg text-center">Your cart is empty.</p>
            </div>

            <div class="cart-summary" style="display: none;" id="cartSummary">
              <div class="cart-row">
                <span>Subtotal</span>
                <span id="cartSubtotal">$0.00</span>
              </div>
              <div class="cart-row" id="cartDiscountRow" style="display: none; color: var(--primary);">
                <span id="cartDiscountName">Discount</span>
                <span id="cartDiscount">-$0.00</span>
              </div>
              <div class="cart-row">
                <span>Tax (8%)</span>
                <span id="cartTax">$0.00</span>
              </div>
              <div class="cart-row total-row">
                <span>Total</span>
                <span id="cartTotal">$0.00</span>
              </div>

              <% if (locals.user) { %>
                <button class="btn btn-primary btn-full mt-2" id="checkoutBtn">🎉 Place Order</button>
              <% } else { %>
                <a href="/auth/login" class="btn btn-primary btn-full mt-2 text-center" style="display:block; text-align:center;">Login to Checkout</a>
              <% } %>
            </div>
          </div>
        </aside>
      </div>
    </div>

    <!-- Bill Modal -->
    <div class="modal-overlay" id="billModal">
      <div class="bill-modal">
        <div id="billContent">
          <div class="bill-header">
            <h2>Your Bill</h2>
            <button class="close-modal" id="closeBillBtn">✕</button>
          </div>
          <div class="bill-body">
            <div class="bill-items-list" id="billItemsContainer">
              <!-- Items injected here -->
            </div>
            <div class="bill-divider"></div>
            <div class="bill-summary-row">
              <span>Subtotal</span>
              <span id="billSubtotal">$0.00</span>
            </div>
            <div class="bill-summary-row" id="billDiscountRow" style="display: none; color: var(--primary);">
              <span id="billDiscountName">Discount</span>
              <span id="billDiscount">-$0.00</span>
            </div>
            <div class="bill-summary-row">
              <span>Tax (8%)</span>
              <span id="billTax">$0.00</span>
            </div>
            <div class="bill-total-row">
              <span>Total to Pay</span>
              <span id="billTotal">$0.00</span>
            </div>
          </div>
          <div class="bill-footer">
            <button class="pay-btn" id="payBtn">Pay $0.00</button>
          </div>
        </div>
        
        <div class="success-content" id="successContent">
          <div class="success-icon">🎉</div>
          <h2 class="success-title">Payment Successful!</h2>
          <p class="success-desc">Your order has been placed successfully and is being prepared.</p>
          <button class="btn btn-primary" id="continueBtn" style="border-radius: 12px; padding: 12px 24px;">Continue Exploring</button>
        </div>
      </div>
    </div>
  </div>

<script>
  // ─── Cart State ───────────────────────────────────────────────
  const cart = {}; // { itemId: { name, price, qty } }

  function updateCartUI() {
    const cartItemsEl = document.getElementById('cart-items');
    const cartSummaryEl = document.getElementById('cartSummary');
    const ids = Object.keys(cart).filter(k => cart[k].qty > 0);

    if (ids.length === 0) {
      cartItemsEl.innerHTML = '<p class="empty-cart-msg text-center">Your cart is empty.</p>';
      cartSummaryEl.style.display = 'none';
      return;
    }

    cartItemsEl.innerHTML = ids.map(id => `
      <div class="cart-item">
        <div class="cart-item-info">
          <h4>${cart[id].name}</h4>
          <span class="cart-item-price">$${(cart[id].price * cart[id].qty).toFixed(2)}</span>
        </div>
        <div class="cart-item-actions">
          <button class="cart-btn" onclick="changeQty('${id}', -1)">−</button>
          <span class="cart-qty">${cart[id].qty}</span>
          <button class="cart-btn" onclick="changeQty('${id}', 1)">+</button>
        </div>
      </div>
    `).join('');

    const subtotal = ids.reduce((s, id) => s + cart[id].price * cart[id].qty, 0);
    
    let discountRate = 0;
    let discountName = '';
    const membership = localStorage.getItem('membership');
    if (membership === 'Silver') { discountRate = 0.05; discountName = 'Silver (5%)'; }
    else if (membership === 'Gold') { discountRate = 0.15; discountName = 'Gold (15%)'; }
    else if (membership === 'Platinum') { discountRate = 0.25; discountName = 'Platinum (25%)'; }

    const discountAmount = subtotal * discountRate;
    const afterDiscount = subtotal - discountAmount;
    const tax = afterDiscount * 0.08;
    const total = afterDiscount + tax;

    document.getElementById('cartSubtotal').textContent = '$' + subtotal.toFixed(2);
    
    const discountRow = document.getElementById('cartDiscountRow');
    if (discountRate > 0) {
      discountRow.style.display = 'flex';
      document.getElementById('cartDiscountName').textContent = 'Discount ' + discountName;
      document.getElementById('cartDiscount').textContent = '-$' + discountAmount.toFixed(2);
    } else {
      if (discountRow) discountRow.style.display = 'none';
    }

    document.getElementById('cartTax').textContent = '$' + tax.toFixed(2);
    document.getElementById('cartTotal').textContent = '$' + total.toFixed(2);
    cartSummaryEl.style.display = 'block';
  }

  function addToCart(id, name, price) {
    if (!cart[id]) cart[id] = { name, price: parseFloat(price), qty: 0 };
    cart[id].qty++;
    updateCartUI();
    // Flash the button
    const btn = document.querySelector(`[data-id="${id}"]`);
    if (btn) { btn.textContent = 'Added ✓'; setTimeout(() => btn.textContent = 'Add to Cart', 1000); }
  }

  function changeQty(id, delta) {
    if (!cart[id]) return;
    cart[id].qty = Math.max(0, cart[id].qty + delta);
    if (cart[id].qty === 0) delete cart[id];
    updateCartUI();
  }

  // ─── Render Menu ─────────────────────────────────────────────
  function renderMenu(items) {
    const container = document.getElementById('menuMain');
    if (!items || items.length === 0) {
      container.innerHTML = '<p class="text-center" style="color:var(--text-muted);padding:60px 20px;">No menu items available yet. Check back soon!</p>';
      return;
    }

    const categories = [...new Set(items.map(i => i.category).filter(Boolean))];

    // Category tabs
    const tabsHtml = `
      <div class="menu-category-tabs">
        <button class="menu-cat-tab active" onclick="filterCategory('all', this)">All</button>
        ${categories.map(c => `<button class="menu-cat-tab" onclick="filterCategory('${c}', this)">${c}</button>`).join('')}
      </div>
    `;

    // All cards
    const cardsHtml = categories.map(category => {
      const catItems = items.filter(i => i.category === category);
      return `
        <div class="menu-category fade-in-up" data-cat="${category}">
          <h2 class="category-title">${category}</h2>
          <div class="menu-grid">
            ${catItems.map(item => `
              <div class="menu-card">
                <div class="menu-img">
                  <span class="menu-tag">New</span>
                  ${item.image
                    ? `<img src="${item.image}" alt="${item.name}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">`
                    : ''}
                  <span class="no-img" style="${item.image ? 'display:none' : ''}">🍽️</span>
                </div>
                <div class="menu-info">
                  <div class="menu-info-top">
                    <h3>${item.name}</h3>
                    <span class="price">₹${Number(item.price).toFixed(2)}</span>
                  </div>
                  <p class="item-desc">${item.description || 'Freshly prepared with quality ingredients.'}</p>
                  <div class="menu-card-footer">
                    <div class="rating-stars">⭐⭐⭐⭐⭐</div>
                    <button class="add-to-cart-btn" data-id="${item._id}" data-name="${item.name}" data-price="${item.price}"
                      onclick="addToCart('${item._id}', '${(item.name || '').replace(/'/g, "\\'")}', ${item.price})">
                      Add to Cart
                    </button>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }).join('');

    container.innerHTML = tabsHtml + cardsHtml;
  }

  function filterCategory(cat, btn) {
    // Update active tab
    document.querySelectorAll('.menu-cat-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    // Show/hide sections
    document.querySelectorAll('.menu-category').forEach(sec => {
      if (cat === 'all' || sec.dataset.cat === cat) {
        sec.style.display = '';
      } else {
        sec.style.display = 'none';
      }
    });
  }

  // ─── Fetch Menu ──────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('menuMain');
    try {
      const res = await fetch('/api/menu');
      if (!res.ok) throw new Error('Server error ' + res.status);
      const result = await res.json();

      // API returns { status, message, data }
      const items = Array.isArray(result.data) ? result.data : [];
      renderMenu(items);

    } catch (err) {
      console.error('Menu fetch error:', err);
      container.innerHTML = `
        <div class="menu-loading">
          <p style="color:var(--accent);">⚠️ Failed to load menu. Please refresh the page.</p>
        </div>`;
    }
  });

  // ─── Checkout Flow ─────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    const checkoutBtn = document.getElementById('checkoutBtn');
    const billModal = document.getElementById('billModal');
    const closeBillBtn = document.getElementById('closeBillBtn');
    const payBtn = document.getElementById('payBtn');
    const continueBtn = document.getElementById('continueBtn');
    const billContent = document.getElementById('billContent');
    const successContent = document.getElementById('successContent');

    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', () => {
        // Populate bill
        const ids = Object.keys(cart).filter(k => cart[k].qty > 0);
        if (ids.length === 0) return;

        let subtotal = 0;
        const billItemsHtml = ids.map(id => {
          const itemTotal = cart[id].price * cart[id].qty;
          subtotal += itemTotal;
          return `
            <div class="bill-item">
              <span class="bill-item-name">${cart[id].name}</span>
              <span class="bill-item-qty">x${cart[id].qty}</span>
              <span class="bill-item-price">₹${itemTotal.toFixed(2)}</span>
            </div>
          `;
        }).join('');

        document.getElementById('billItemsContainer').innerHTML = billItemsHtml;

        let discountRate = 0;
        let discountName = '';
        const membership = localStorage.getItem('membership');
        if (membership === 'Silver') { discountRate = 0.05; discountName = 'Silver (5%)'; }
        else if (membership === 'Gold') { discountRate = 0.15; discountName = 'Gold (15%)'; }
        else if (membership === 'Platinum') { discountRate = 0.25; discountName = 'Platinum (25%)'; }

        const discountAmount = subtotal * discountRate;
        const afterDiscount = subtotal - discountAmount;
        const tax = afterDiscount * 0.08;
        const total = afterDiscount + tax;

        document.getElementById('billSubtotal').textContent = '₹' + subtotal.toFixed(2);
        
        const billDiscountRow = document.getElementById('billDiscountRow');
        if (discountRate > 0) {
          billDiscountRow.style.display = 'flex';
          document.getElementById('billDiscountName').textContent = 'Discount ' + discountName;
          document.getElementById('billDiscount').textContent = '-₹' + discountAmount.toFixed(2);
        } else {
          billDiscountRow.style.display = 'none';
        }

        document.getElementById('billTax').textContent = '₹' + tax.toFixed(2);
        document.getElementById('billTotal').textContent = '₹' + total.toFixed(2);
        payBtn.textContent = 'Pay ₹' + total.toFixed(2);

        // Reset modal state
        billContent.style.display = 'block';
        successContent.style.display = 'none';
        billModal.classList.add('show');
      });
    }

    if (closeBillBtn) {
      closeBillBtn.addEventListener('click', () => {
        billModal.classList.remove('show');
      });
    }

    if (payBtn) {
      payBtn.addEventListener('click', () => {
        // Simulate payment processing
        payBtn.innerHTML = '<span class="spinner" style="display:inline-block; width:20px; height:20px; border:2px solid #fff; border-top-color:transparent; border-radius:50%; animation:spin 0.8s linear infinite;"></span> Processing...';
        payBtn.disabled = true;

        setTimeout(() => {
          // Empty cart
          Object.keys(cart).forEach(k => delete cart[k]);
          updateCartUI();

          billContent.style.display = 'none';
          successContent.style.display = 'block';
          payBtn.innerHTML = 'Pay';
          payBtn.disabled = false;
        }, 1500);
      });
    }

    if (continueBtn) {
      continueBtn.addEventListener('click', () => {
        billModal.classList.remove('show');
      });
    }
  });
</script>

<%- include('../partials/footer') %>